{
  "name": "vrtourbuilder",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Constructor de tours virtuales 360º",
  "author": "VRTourBuilder",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.vrtourbuilder.app",
    "productName": "VRTourBuilder",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "maintainer": "VRTourBuilder"
    }
  },
  "dependencies": {
    "@photo-sphere-viewer/core": "^5.13.3",
    "@photo-sphere-viewer/gallery-plugin": "^5.14.3",
    "@photo-sphere-viewer/markers-plugin": "^5.13.3",
    "@photo-sphere-viewer/virtual-tour-plugin": "^5.13.3",
    "@xyflow/react": "^12.8.6",
    "file-saver": "^2.0.5",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "idb": "^8.0.3",
    "jquery": "^4.0.0",
    "jszip": "^3.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.9",
    "select2": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/jquery": "^4.0.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/select2": "^4.0.63",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-electron": "^1.1.0"
  }
}
